{
  "name": "resume-tex",
  "version": "1.0.0",
  "description": "Resume in Tex",
  "main": "index.js",
  "scripts": {
    "build": "pnpm pdf && pnpm clean",
    "pdf": "latexmk -pdf -interaction=nonstopmode -halt-on-error resume.tex",
    "watch": "latexmk -pdf -pvc -interaction=nonstopmode -halt-on-error resume.tex",
    "preview": "open resume.pdf",
    "clean": "latexmk -c resume.tex"
  },
  "keywords": [
    "resume",
    "tex"
  ],
  "author": "Milind Mishra<milindmishra4@gmail.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3"
}

